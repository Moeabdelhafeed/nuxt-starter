# Laravel API base URL (no trailing slash)
NUXT_PUBLIC_BASE_URL=http://localhost:8000

# Static API token for X-API-TOKEN header on every backend request
NUXT_PUBLIC_X_API_TOKEN=

# Translations source: "remote" (fetch /api/translations) or "local" (i18n/locales/*.json)
NUXT_PUBLIC_TRANSLATIONS_MODE=remote

# Pusher (used by nuxt-laravel-echo for private channels)
NUXT_PUBLIC_PUSHER_APP_KEY=
NUXT_PUBLIC_PUSHER_APP_CLUSTER=eu

# @nuxtjs/seo OG image signing secret
NUXT_OG_IMAGE_SECRET=

# Firebase Web SDK (social auth)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
